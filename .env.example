# Copy to .env (used by docker-compose.prod.yml on the server).
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=*

# Postgres (AWS RDS in production)
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=change-me
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_SSLMODE=require

# Celery broker (the redis container in docker-compose.prod.yml)
REDIS_URL=redis://redis:6379/0

# Processing tunables (defaults shown)
TRANSACTION_PROCESSING_DELAY_SECONDS=30
TRANSACTION_STALE_AFTER_SECONDS=300
TRANSACTION_RECOVERY_INTERVAL_SECONDS=60
CELERY_VISIBILITY_TIMEOUT=300
